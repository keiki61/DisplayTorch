<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12+. Only the fine-tuned brightness steps are
     backed up or transferred: the remove-ads entitlement is re-verified
     against Google Play on every launch, and ad consent belongs to the device
     it was given on. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="brightness_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="brightness_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
