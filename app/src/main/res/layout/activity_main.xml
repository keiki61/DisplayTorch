<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainActivityLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/grey">

    <!-- Frame shown only in edit mode. Bottom stops at the ad banner so the
         frame surrounds the torch area, not the ad. -->
    <View android:id="@+id/editModeBorder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/edit_mode_border_margin"
        android:background="@drawable/bg_edit_mode_border"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/adContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView android:id="@+id/brightnessTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hello World!"
        android:textColor="@color/black"
        android:textSize="48sp"
        app:layout_constraintBottom_toTopOf="@id/editInfoTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView android:id="@+id/editInfoTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:drawablePadding="8dp"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/editHintTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/brightnessTextView" />

    <TextView android:id="@+id/editHintTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/edit_mode_hint"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/debugInfoTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editInfoTextView" />

    <TextView android:id="@+id/debugInfoTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editHintTextView" />

    <FrameLayout android:id="@+id/adContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView android:id="@+id/resetMenuButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/edit_menu_button_margin"
        android:layout_marginEnd="@dimen/edit_menu_button_margin"
        android:background="@drawable/bg_edit_menu_button"
        android:contentDescription="@string/edit_menu_button_description"
        android:gravity="center"
        android:text="@string/edit_menu_button_glyph"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- First-run tutorial. Last child so it sits on top; clickable so it
         swallows the dismissing tap instead of cycling the brightness. -->
    <FrameLayout android:id="@+id/onboardingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/onboardingScrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_onboarding_card"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="20dp"
                    android:text="@string/onboarding_title"
                    android:textColor="@color/onboardingText"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TableLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shrinkColumns="1">

                    <TableRow>
                        <TextView style="@style/OnboardingGesture" android:text="@string/onboarding_gesture_tap" />
                        <TextView style="@style/OnboardingAction" android:text="@string/onboarding_action_tap" />
                    </TableRow>

                    <TableRow>
                        <TextView style="@style/OnboardingGesture" android:text="@string/onboarding_gesture_two_finger" />
                        <TextView style="@style/OnboardingAction" android:text="@string/onboarding_action_two_finger" />
                    </TableRow>

                    <TableRow>
                        <TextView style="@style/OnboardingGesture" android:text="@string/onboarding_gesture_hold" />
                        <TextView style="@style/OnboardingAction" android:text="@string/onboarding_action_hold" />
                    </TableRow>

                    <TableRow>
                        <TextView style="@style/OnboardingGesture" android:text="@string/onboarding_gesture_volume" />
                        <TextView style="@style/OnboardingAction" android:text="@string/onboarding_action_volume" />
                    </TableRow>
                </TableLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/onboarding_tile_hint"
                    android:textColor="@color/onboardingTextDim"
                    android:textSize="13sp" />

                <Button android:id="@+id/onboardingDismissButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/onboarding_dismiss" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>